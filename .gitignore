# Python
venv/
__pycache__/
*.pyc
.pytest_cache/
*.db

# Env -- and any copy of it kept beside it before an edit: it holds the secret key
# and the admin password.
.env
*.env.bak*

# Server logs
*.log
*.log.err

# Documents uploaded through the platform: project files, not source.
backend/uploads/

# Database backups taken before migrations and on request: data, not source.
backend/backups/

# Node / frontend
node_modules/
dist/
.vite/

# Editor / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# The company library is kept in the (private) repository, so a clone on a new
# PC has the company documents, templates, stamp and datasheets without the
# archive. Screen recordings are not documents the platform reads, and at
# ~97 MB each sit at GitHub's file-size limit.
backend/library/**/*.mp4

# Derived data: the datasheet index, rebuilt from the library on demand.
backend/.cache/

# Data exported from the platform for people to download: a copy of what is in `data base/`.
exports/

# The knowledge base workbooks in `data base/` are tracked (imported on a new
# PC's first start); the SQLite clause database beside them is rebuilt by
# `backend/scripts/build_clause_database.py` and ignored as *.db above.
backend/evaluations/
