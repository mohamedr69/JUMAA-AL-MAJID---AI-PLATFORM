# Copy to .env and fill in real values. Never commit .env.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

DATABASE_URL=sqlite:///./ep_platform.db

# Set true once served over HTTPS in production
COOKIE_SECURE=false

DEFAULT_ADMIN_EMAIL=admin@ep-platform.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

CORS_ORIGINS=["http://localhost:5173"]

# Local-filesystem dev/test shim for the project archive (synced OneDrive
# tree). Production should use Microsoft Graph search against SharePoint.
PROJECTS_ROOT=

# Where documents uploaded through the platform are kept (a folder per
# project). The project archive is only ever read, never written to.
UPLOADS_ROOT=uploads

# Only needed if tesseract.exe is not already on PATH.
TESSERACT_CMD=

# Datasheet libraries by manufacturer, relative to PROJECTS_ROOT (or
# absolute). Leave unset to use the built-in default, which is the Edwards
# library the platform owner designated:
# DATASHEET_LIBRARIES={"EDWARDS": "Systems/01- FAVE/01- Edwards - UL&EN/01- EST4"}
