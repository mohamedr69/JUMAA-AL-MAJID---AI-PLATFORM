# setup.bat copies this to .env and fills SECRET_KEY in; the rest works as it
# is on a new machine. Never commit .env.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

DATABASE_URL=sqlite:///./ep_platform.db

# Everything the platform writes -- the database, uploads, backups, caches --
# in one folder. Point it at a folder OneDrive syncs and the same user finds
# their projects on every PC they sign in on (one PC at a time: close the
# platform before opening it on the other, so the sync finishes). Left unset,
# everything stays under backend/ on this machine. On the first start with it
# set, a database already under backend/ is copied into the folder.
# DATA_ROOT=%USERPROFILE%\Juma Al Majid\EP Platform

# Set true once served over HTTPS in production
COOKIE_SECURE=false

DEFAULT_ADMIN_EMAIL=admin@ep-platform.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

CORS_ORIGINS=["http://localhost:5173"]

# The project archive: the SharePoint library OneDrive syncs to every office
# machine. Leave it unset and the platform finds the synced folder by name
# on whichever machine it runs (under the user profile, %OneDriveCommercial%
# or %OneDrive%). Set it only for an archive kept somewhere unusual; ~ and
# %USERPROFILE% are expanded. Production should use Microsoft Graph search
# against SharePoint instead.
# PROJECTS_ROOT=
# The synced folder's name, if the library is ever renamed.
# PROJECTS_ROOT_NAME=SSD FIRE ALARM PROJECTS - Fire Alarm 2021 Projects

# The archive index: the archive's EP folders, walked once and then kept in
# the database, so typing an EP number suggests projects instead of walking
# a synced drive for every keystroke. A folder is stored as its path below
# the archive root, never as C:\Users\<somebody>\..., so the index works for
# every engineer and can live in a shared DATA_ROOT folder.
# false: every Find Project walks the archive, as before.
# ARCHIVE_INDEX_ENABLED=true
# Build the index on server start when it has never been built or has gone
# stale. Nothing waits for it; the first walk takes minutes over OneDrive.
# ARCHIVE_INDEX_SCAN_ON_START=true
# How old a complete scan may get before the server runs another. This is
# what notices an EP folder added to OneDrive today.
# ARCHIVE_INDEX_REFRESH_MINUTES=30
# Or run one by hand: python -m scripts.scan_archive (--dry-run, --status).

# Where documents uploaded through the platform are kept (a folder per
# project). The project archive is only ever read, never written to.
UPLOADS_ROOT=uploads

# Only needed if tesseract.exe is not already on PATH. Tesseract is optional:
# document intake, document control and the submittal scanner read scanned
# page numbers and stamps with it. The DRF and the Design Sheets are read by
# the AI only (below).
TESSERACT_CMD=

# AutoCAD's Core Console, which turns an uploaded IFC DWG into DXF for the BOQ
# as per IFC drawings. Only needed when AutoCAD is not under
# C:\Program Files\Autodesk\AutoCAD <year>\ -- that is searched, newest
# first, then the free ODA File Converter. With neither, DXF still works.
# ACCORECONSOLE_PATH=

# --- The company library --------------------------------------------------
# Everything a submittal needs that is NOT about a particular project: the
# company documents, the templates and the manufacturers' datasheets. One
# local folder with a fixed structure -- see backend/library/README.md.
#
# Unset means backend/library, resolved from the code, so it does not matter
# where uvicorn is started from. Point it at a shared drive to give a whole
# team one library.
LIBRARY_ROOT=

# A manufacturer is normally DISCOVERED: a folder under library/datasheets/
# is a library named for the brand, so adding one is dropping a folder in.
# This is only the override, for a library kept somewhere else.
# DATASHEET_LIBRARIES={"MENVIER": "D:/libraries/menvier"}

# The submittal builder, relative to LIBRARY_ROOT or absolute.
SUBMITTAL_LIBRARY=submittal

# Derived data (the datasheet index). Never inside the library: that folder
# can be read-only or synced. Unset means backend/.cache.
CACHE_ROOT=

# How long a library's file listing is trusted before it is walked again.
# A BOQ's fifty parts are fifty lookups, and re-walking a synced folder every
# time was the whole cost of the page. 0 disables the throttle.
LIBRARY_RESCAN_SECONDS=60

# --- Fallback: the library as it was filed in the archive ------------------
# Used only for what the local library does not hold yet, so a machine
# mid-migration keeps working. `python scripts/sync_library.py` copies them
# across; after that these can be left unset.
# ARCHIVE_DATASHEET_LIBRARIES={"EDWARDS": "Systems/01- FAVE/01- Edwards - UL&EN/01- EST4"}
# ARCHIVE_SUBMITTAL_LIBRARY=Systems/01- FAVE/01- Edwards - UL&EN/01- EST4/submittal builder

# --- Selective AI assistance -----------------------------------------------
# A model is asked only about what the deterministic read could not settle:
# an unreadable quantity cell, an unlabelled design sheet, a low-confidence
# DRF field. Its answers are proposals an engineer accepts; the model never
# writes a value into a project. Off by default.
AI_ENABLED=true

# How the model is reached:
#   claude-code  Claude through the Claude Code CLI, on the Claude subscription
#                signed in on this server. No API key. Install Claude Code and
#                sign in once by running `claude` as the user the server runs as.
#   claude       the Anthropic API, with AI_API_KEY or ANTHROPIC_API_KEY
#   openai       the OpenAI API, with AI_API_KEY or OPENAI_API_KEY
AI_PROVIDER=claude-code
# Switch individual AI tasks off without a code change, comma separated
# (read_cell, read_field, classify_system, answer_clauses, review_clauses, ask_clause, verify_spec).
AI_DISABLED_TASKS=

# claude-code only: the Claude Code program, when `claude` is not on the PATH.
# AI_CLAUDE_CLI=C:\Users\<you>\AppData\Local\Microsoft\WinGet\Packages\Anthropic.ClaudeCode_...\claude.exe

# The API providers only. This file is gitignored; never commit a key.
AI_API_KEY=

# Models. Both tiers are Claude Fable 5.1: the small tier makes the first
# reading of a page, row or form; the standard tier the second, independent
# one (of a different image: a close-up) and the escalation. For claude-code
# a Claude Code alias (fable, opus, sonnet) or the full id both work; for the
# APIs use the ids from the account's model list (`python scripts/ai_selftest.py --all`).
AI_MODEL_SMALL=claude-fable-5-1
AI_MODEL_STANDARD=claude-fable-5-1

# The AI read of a project's documents on its first open (app/ai/sheet_reader.py):
# the model reads every page of every Design Sheet, the OCR read is the
# witness, and the reading is stored for good in the database (document_readings)
# -- a document with the same content is never read by a model again, on
# this project reopened or on any other. The DRF is read the same way by the
# AI check of Project Info. Calls one document may take (one per page band,
# plus close-ups of disputed rows), calls a project may make in a day across
# reads, the time a read may take, and the reasoning depth for a page (API only).
AI_READ_MAX_CALLS_PER_DOCUMENT=60
AI_READ_MAX_CALLS_PER_PROJECT_PER_DAY=600
AI_READ_MAX_ELAPSED_S=1800
AI_READ_EFFORT=high

# Ceilings. The call counts and the time limit always bind. The per-job
# cost cap and the cost column only work once the prices below are set
# from the vendor's pricing page -- they start at zero because a made-up
# price is worse than none.
AI_MAX_CALLS_PER_DOCUMENT=12
AI_MAX_CALLS_PER_PROJECT_PER_DAY=60
AI_MAX_COST_PER_JOB=0.50
AI_PRICE_INPUT_PER_MILLION=0
AI_PRICE_OUTPUT_PER_MILLION=0

# --- Compliance statements -------------------------------------------------
# Python reads the specification's clauses, answers them from the compliance
# knowledge base -- every clause the company answered in a past statement,
# built from the statements found under PROJECTS_ROOT, by system,
# manufacturer and specification family (kept under CACHE_ROOT; rebuilt
# from the page or with scripts/build_compliance_knowledge.py) -- and writes
# the workbook; the model sees only the clauses left over, many per call.
AI_COMPLIANCE_BATCH_CLAUSES=25
AI_COMPLIANCE_MAX_OUTPUT_TOKENS=3000
AI_COMPLIANCE_MAX_CALLS_PER_STATEMENT=12
# A past answer is reused without asking at this similarity (0-1).
COMPLIANCE_REUSE_SIMILARITY=0.86

# --- The compliance knowledge base -----------------------------------------
# The folder holding the Compliance Response Database workbook
# (Compliance_Response_Database.xlsx) and its exports, as synced from
# OneDrive. An import source only: "Update knowledge base" copies its records
# into the application database, which is what autofill queries, so the
# folder need not be reachable at run time. Unset means imports cannot run on
# this machine; knowledge already imported keeps working.
# Leave unset to use the repository's own `data base` folder, which is
# imported on the first start. Set it only for a source kept elsewhere.
# COMPLIANCE_KNOWLEDGE_SOURCE=C:\Users\<you>\OneDrive - Juma Al Majid\Compliance_Response_Database

