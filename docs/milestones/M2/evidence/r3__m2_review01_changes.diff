+        annot.set_colors(stroke=(0, 0.5, 0))
+        annot.update()
+        assert dc.decision_marks(page, OPTIONS + COMMENT) == []
+        assert dc.boxed_decision(page, OPTIONS + COMMENT) is None
+        assert dc.annotated_decision(page, OPTIONS + COMMENT) is None
