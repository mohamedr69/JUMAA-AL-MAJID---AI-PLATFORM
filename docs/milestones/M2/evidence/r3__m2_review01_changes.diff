+
+def _frame(page, phrase: str, pad: float = 2.0):
+    return page.search_for(phrase)[0] + (-pad, -pad, pad, pad)
+
+
+def test_an_annotation_round_a_comment_that_mentions_an_option_is_not_a_decision(tmp_path):
