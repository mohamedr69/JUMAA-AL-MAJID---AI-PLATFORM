+    kinds = {document_control.describe_note(note)[0] for note in (row.extracted or {}).get("notes") or []}
+    if "unavailable" in kinds:
+        return "unavailable"
+    if "failed" in kinds:
+        return "failed"
+    if "partial" in kinds:
+        return "partial"
+    return "processed"
